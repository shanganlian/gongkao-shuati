# 复制到 /etc/bideti/bideti.env，权限 root:bideti 640
# 不要把真实密钥提交到 Git，也不要用 echo 写入（会留在 shell history）

NODE_ENV=production
PORT=3002

# 必填：DeepSeek 密钥
DEEPSEEK_API_KEY=sk-replace-with-real-key

# 大陆服务器通常无法访问 Google；不要配置 GEMINI_API_KEY。
# 相关接口会走内置降级，浏览器朗读由 SpeechSynthesis 本地完成。
# GEMINI_API_KEY=

# 不配置时使用 shared/api-auth.ts 内置的公开 Supabase 配置；
# 如果要切换到自己的项目，再填写：
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
