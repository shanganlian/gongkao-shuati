# 复制到 /etc/bideti/bideti.env，权限 root:bideti 640
# 不要把真实密钥提交到 Git，也不要用 echo 写入（会留在 shell history）

NODE_ENV=production
PORT=3002

# 必填：DeepSeek 密钥
DEEPSEEK_API_KEY=sk-replace-with-real-key

# 大陆服务器通常无法访问 Google；不要配置 GEMINI_API_KEY。
# 相关接口会走内置降级，浏览器朗读由 SpeechSynthesis 本地完成。
# GEMINI_API_KEY=

# 不配置时使用 shared/api-auth.ts 内置的公开 Supabase 配置；
# 如果要切换到自己的项目，再填写：
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# 邮箱验证码（QQ SMTP）
# SMTP_PASS 填 QQ 邮箱「设置 → 账户 → POP3/SMTP 服务」生成的授权码，不是 QQ 登录密码。
# 授权码只写在服务器本文件与本地 .env，不要提交 Git，也不要用 echo 写入。
# 以下 SMTP_USER / SMTP_PASS / SMTP_FROM_EMAIL 三项都非空时，status 接口才会返回 configured=true；
# SMTP_FROM_EMAIL 必须与 SMTP_USER 完全相同，否则 QQ 会返回 553。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=
SMTP_FROM_NAME=必得题库
SMTP_FROM_EMAIL=your_qq_email@qq.com

# 邮件内「一键登录」跳回的站点
SITE_URL=https://igoiget.com

# 后端校验验证码后，调用 Supabase Admin 生成一次性登录令牌。
# 该 key 权限极高，只能放在服务端；从 Supabase Dashboard → Project Settings → API → service_role 获取。
# 留空时只能发码、不能完成登录；status.serviceRoleConfigured 会显示 false。
SUPABASE_SERVICE_ROLE_KEY=

# 可选：验证码哈希固定盐；不填则每次进程启动随机生成（重启后旧码失效）
EMAIL_CODE_SECRET=
