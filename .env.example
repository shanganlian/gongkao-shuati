DEEPSEEK_API_KEY=your_deepseek_api_key_here

# QQ 互联登录（默认关闭，可以不填）
# 只有 QQ_LOGIN_ENABLED=1 且 QQ_APP_ID / QQ_APP_KEY 都配置时，服务端才放行 /api/auth/qq/*；
# 否则该前缀下一律 404。前端按钮还要构建时 VITE_QQ_LOGIN_ENABLED=1 才会渲染。
QQ_LOGIN_ENABLED=0
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=https://igoiget.com/api/auth/qq/callback
VITE_QQ_LOGIN_ENABLED=0

# 邮箱验证码（QQ SMTP）：SMTP_PASS 填 QQ 邮箱「设置 → 账户 → POP3/SMTP 服务」生成的授权码，不是 QQ 登录密码。
# /api/auth/email-code/status 的 configured=true 只要求 SMTP_USER、SMTP_PASS、SMTP_FROM_EMAIL 三项非空；
# 其中 SMTP_FROM_EMAIL 必须与 SMTP_USER 完全相同，否则 QQ 会返回 553。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=
SMTP_FROM_NAME=必得题库
SMTP_FROM_EMAIL=your_qq_email@qq.com

# 邮件里「一键登录」跳回的站点；本地可用 http://localhost:3002，生产用 https://igoiget.com
SITE_URL=http://localhost:3002

# 后端校验验证码后，用 Supabase admin 生成一次性登录令牌；只在服务端配置，绝不能进前端
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# 可选：给验证码哈希加固定盐；不填则每次进程启动随机生成（重启后旧码失效）
EMAIL_CODE_SECRET=
