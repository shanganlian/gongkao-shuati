DEEPSEEK_API_KEY=your_deepseek_api_key_here

# QQ 互联登录（默认关闭，可以不填）
# 只有 QQ_LOGIN_ENABLED=1 且 QQ_APP_ID / QQ_APP_KEY 都配置时，服务端才放行 /api/auth/qq/*；
# 否则该前缀下一律 404。前端按钮还要构建时 VITE_QQ_LOGIN_ENABLED=1 才会渲染。
QQ_LOGIN_ENABLED=0
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=https://igoiget.com/api/auth/qq/callback
VITE_QQ_LOGIN_ENABLED=0
